<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- MicaGo talks to the relay server over HTTP(S). INTERNET must be in the
         main manifest (Flutter only auto-adds it to debug/profile builds). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Camera is used only for the QR pairing scanner (mobile_scanner). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- C37: record voice messages (requested at runtime when the user records). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Read-only contacts, requested on demand for local handle→name matching.
         WRITE_CONTACTS is intentionally NOT declared; contacts are never
         modified or uploaded. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- C21c: photo_manager reads the gallery for the attachment media grid.
         Android 13+ uses the granular READ_MEDIA_* permissions; older versions
         fall back to READ_EXTERNAL_STORAGE (capped at SDK 32). Media is only
         read to stage attachments the user selects; nothing is uploaded without
         an explicit send. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- C22: show FCM-driven message notifications on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- C29: optional "Keep MicaGo running" foreground service that holds the
         WebSocket open in the background. Off by default; only started when the
         user enables it in advanced settings. dataSync = keep a sync connection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="micaGO"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher_default"
        android:roundIcon="@mipmap/ic_launcher_default_round"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic enables plain http:// to local/LAN servers
             (e.g. http://192.168.x.x). Public endpoints use https via the tunnel. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- PackageManager resolves MAIN/INFO before MAIN/LAUNCHER.
                 Notifications and conversation shortcuts therefore target the stable
                 activity, including after their original icon alias is disabled. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="application/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="application/*"/>
            </intent-filter>
        </activity>
        <!-- Only aliases own launcher entries. MainActivity remains enabled for
             notifications, sharing and existing home-screen shortcuts. -->
        <activity-alias android:name=".DefaultIcon" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher_default" android:roundIcon="@mipmap/ic_launcher_default_round">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ClassicIcon" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".MinimalIcon" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_minimal" android:roundIcon="@mipmap/ic_launcher_minimal_round">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" android:exported="false" />
        <!-- C29: optional keep-alive foreground service (off by default). -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_micago_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="micago_messages" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
