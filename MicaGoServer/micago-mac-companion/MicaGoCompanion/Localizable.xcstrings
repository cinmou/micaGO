        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限：%@"
          }
        }
      }
    },
    "Advanced. You normally don't need to change this, since micaGO uses the bundled backend.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级选项。micaGO 使用内置后端，一般不需要改。"
