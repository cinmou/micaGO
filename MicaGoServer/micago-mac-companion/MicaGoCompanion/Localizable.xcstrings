    "Blocking stops new messages for this target from being saved to the relay. Messages already synced stay.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽后，这个对象的新消息不再保存到中继，已同步的消息会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖後，這個對象的新訊息不再儲存到中繼，已同步的訊息會保留。"
