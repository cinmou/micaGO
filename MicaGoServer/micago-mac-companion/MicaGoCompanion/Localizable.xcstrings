{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ · up %@": {
      "comment": "A subheading with version info and uptime. The argument is the string “%args”, the string “%argm” or the string “%1$argh %2$argm”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · up %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 已运行 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 已執行 %@"
          }
        }
      }
    },
    "%@: %@": {
      "comment": "A label that shows the current status of the login at launch setting. The text is a combination of \"Enabled\" or \"Disabled\" and a description of the status, like \"enabled but not available on this device\" or \"enabled but not available on this version of macOS\". The argument is the string “settings.login.status”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A segmented picker that lets the user select the number of messages to display in the list.",
      "isCommentAutoGenerated": true
    },
    "%lld active connection%@": {
      "comment": "A label that shows the number of active connections. The argument is the count of active connections.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld active connection%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 个活动连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個作用中連線"
          }
        }
      }
    },
    "3000": {
      "comment": "The default port for the server",
      "isCommentAutoGenerated": true
    },
    "A newer backend build exists, but the override path points to an older one. Clear the override or update it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新的后端版本，但自定义路径指向了旧版本。请清除或更新自定义路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新的後端版本，但自訂路徑指向了舊版本。請清除或更新自訂路徑。"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於"
          }
        }
      }
    },
    "Access: %@": {
      "comment": "A label that describes the authorization status of the user's contacts.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限：%@"
          }
