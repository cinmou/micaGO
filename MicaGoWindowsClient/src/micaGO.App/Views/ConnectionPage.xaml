<Page
    x:Class="MicaGo.App.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource MicaGoThreadBrush}">
        <Border Width="560"
                MaxWidth="560"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Spacing="18">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="micaGO" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Connect this Windows PC to your micaGO server"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="Pairing JSON" />
                    <PasswordBox x:Name="PairingJsonBox"
                                 MinHeight="42"
                                 PasswordRevealMode="Peek"
                                 PlaceholderText="Paste the pairing JSON from micaGO Companion"
                                 PasswordChanged="PairingJsonBox_PasswordChanged" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Text="The token is stored in Windows Credential Manager and is never written to the connection file."
                               TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="StatusBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Informational" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing x:Name="ConnectProgress" Width="20" Height="20" IsActive="False" />
                        <TextBlock x:Name="ConnectPhaseText"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>
                    <Button x:Name="ConnectButton"
                            Grid.Column="1"
                            MinWidth="112"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Connect"
                            IsEnabled="False"
                            Click="ConnectButton_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
