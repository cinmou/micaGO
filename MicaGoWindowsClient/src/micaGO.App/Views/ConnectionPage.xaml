<Page
    x:Class="MicaGo.App.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hosted in ConnectionWindow. The page stays transparent so the single
         pairing card sits directly on the window's Mica backdrop — no nested
         surface behind it. -->
    <Grid Background="Transparent">
        <Border Width="520"
                MaxWidth="520"
                Padding="28,24,28,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="micaGO" />
                        <TextBlock x:Name="SubtitleText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Text="Connect this Windows PC to your micaGO server"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ConnectButton"
                            Grid.Column="1"
                            MinWidth="104"
                            VerticalAlignment="Top"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Connect"
                            IsEnabled="False"
                            Click="ConnectButton_Click" />
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="PairingJsonLabel"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="Pairing JSON" />
                    <PasswordBox x:Name="PairingJsonBox"
                                 MinHeight="42"
                                 PasswordRevealMode="Peek"
                                 PlaceholderText="Paste the pairing JSON from micaGO Companion"
                                 PasswordChanged="PairingJsonBox_PasswordChanged" />
                    <TextBlock x:Name="TokenNoteText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Text="The token is stored in Windows Credential Manager and is never written to the connection file."
                               TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="StatusBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Informational" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="ConnectProgress" Width="18" Height="18" IsActive="False" />
                    <TextBlock x:Name="ConnectPhaseText"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
