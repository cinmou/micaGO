<Page x:Class="MicaGo.App.Views.HiddenMessagesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MicaGo.App.Views">
    <Grid Background="Transparent"><Grid MaxWidth="1000" Margin="36,12,36,24" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,4,0,12" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource MicaGoIconButtonStyle}" Click="BackButton_Click"><FontIcon FontSize="16" Glyph="&#xE72B;"/></Button><TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}"/><Button x:Name="SelectButton" Grid.Column="2" Style="{StaticResource MicaGoIconButtonStyle}" Click="SelectButton_Click"><FontIcon FontSize="16" Glyph="&#xE762;"/></Button><Button x:Name="SelectAllButton" Grid.Column="3" Style="{StaticResource MicaGoIconButtonStyle}" Visibility="Collapsed" Click="SelectAllButton_Click"><FontIcon FontSize="16" Glyph="&#xE8B3;"/></Button><Button x:Name="CancelSelectionButton" Grid.Column="4" Style="{StaticResource MicaGoIconButtonStyle}" Visibility="Collapsed" Click="CancelSelectionButton_Click"><FontIcon FontSize="16" Glyph="&#xE711;"/></Button></Grid>
        <Grid Grid.Row="1"><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed"><FontIcon HorizontalAlignment="Center" FontSize="42" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8F2;"/><TextBlock x:Name="EmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel x:Name="ListPanel" Spacing="8"><TextBlock x:Name="CountText" Style="{StaticResource MicaGoSettingsHeaderStyle}"/><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><ListView x:Name="HiddenMessagesList" Background="Transparent" IsItemClickEnabled="True" ItemClick="List_ItemClick" SelectionChanged="List_SelectionChanged" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="local:HiddenMessageRow"><Grid MinHeight="64" Padding="12,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="2"><Grid><TextBlock FontWeight="SemiBold" Text="{x:Bind Title}"/><TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Time}"/></Grid><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="RestoreOneButton" Grid.Column="1" Style="{StaticResource MicaGoIconButtonStyle}" Tag="{x:Bind Id}" Click="RestoreOneButton_Click"><FontIcon FontSize="16" Glyph="&#xE890;"/></Button></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border></StackPanel></Grid>
        <StackPanel Grid.Row="2" Spacing="8"><InfoBar x:Name="RestoreInfoBar" IsOpen="False" IsClosable="True" Severity="Success"/><Button x:Name="RestoreSelectedButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="RestoreSelectedButton_Click"/></StackPanel>
    </Grid></Grid>
</Page>
