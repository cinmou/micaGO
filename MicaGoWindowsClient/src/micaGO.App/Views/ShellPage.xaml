<Page
    x:Class="MicaGo.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MicaGo.App.Controls"
    xmlns:models="using:MicaGo.Core.Models">

    <Grid x:Name="ShellRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="280" MaxWidth="480" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource MicaGoSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox"
                                Height="40"
                                PlaceholderText="Search"
                                TextChanged="SearchBox_TextChanged">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource MicaGoIconButtonStyle}"
                        ToolTipService.ToolTip="Settings"
                        Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
            </Grid>

            <ListView x:Name="ChatList"
                      Grid.Row="1"
                      IsItemClickEnabled="True"
                      ItemClick="ChatList_ItemClick"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource MicaGoChatListStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatSummary">
                        <Grid Padding="8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource MicaGoAccentBrush}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="{x:Bind Initials}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="6">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Text="{x:Bind Time}" />
                                <Border x:Name="UnreadBadge" MinWidth="18" Height="18" Padding="5,0" HorizontalAlignment="Right" Background="{StaticResource MicaGoAccentBrush}" CornerRadius="9" Opacity="{x:Bind UnreadBadgeOpacity}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" Text="{x:Bind UnreadCount}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="#1A9B55" />
                <TextBlock x:Name="ConnectionStatusText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Text="Connected" />
            </Grid>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource MicaGoDividerBrush}" />

        <Grid Grid.Column="2" Background="{ThemeResource MicaGoThreadBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="ThreadTitle" FontSize="16" FontWeight="SemiBold" Text="Select a conversation" />
                    <TextBlock x:Name="ThreadSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Text="Messages stay on this device" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource MicaGoIconButtonStyle}" ToolTipService.ToolTip="Conversation info">
                    <FontIcon Glyph="&#xE946;" />
                </Button>
            </Grid>
            <Rectangle Grid.Row="1" Fill="{ThemeResource MicaGoDividerBrush}" />

            <Grid Grid.Row="2">
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8BD;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Choose a conversation to start" />
                </StackPanel>
                <ListView x:Name="MessageList"
                          Padding="0,16,0,12"
                          SelectionMode="None"
                          IsTabStop="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Message">
                            <controls:MessageBubble />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Row="3" Padding="14,10,14,14" Background="{ThemeResource MicaGoSidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Button IsEnabled="False" Style="{StaticResource MicaGoIconButtonStyle}" ToolTipService.ToolTip="Attach">
                    <FontIcon Glyph="&#xE723;" />
                </Button>
                <TextBox x:Name="Composer"
                         Grid.Column="1"
                         Margin="8,0"
                         MinHeight="40"
                         MaxHeight="128"
                         AcceptsReturn="True"
                         IsEnabled="False"
                         TextWrapping="Wrap"
                         PlaceholderText="Message"
                         TextChanged="Composer_TextChanged"
                         KeyDown="Composer_KeyDown" />
                <Button x:Name="SendButton"
                        Grid.Column="2"
                        IsEnabled="False"
                        Style="{StaticResource MicaGoIconButtonStyle}"
                        ToolTipService.ToolTip="Send"
                        Click="SendButton_Click">
                    <FontIcon Glyph="&#xE724;" Foreground="{StaticResource MicaGoAccentBrush}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
