<Page
    x:Class="MicaGo.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:MicaGo.App"
    xmlns:controls="using:MicaGo.App.Controls"
    xmlns:models="using:MicaGo.Core.Models">

    <Grid x:Name="ShellRoot" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="340" MinWidth="280" MaxWidth="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar and thread header intentionally reveal one continuous Mica surface. -->
        <Grid x:Name="ChatSidebar" Grid.Column="0" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Grid Padding="12,8,8,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox"
                                VerticalAlignment="Center"
                                PlaceholderText="Search conversations"
                                TextMemberPath="Title"
                                TextChanged="SearchBox_TextChanged"
                                SuggestionChosen="SearchBox_SuggestionChosen"
                                QuerySubmitted="SearchBox_QuerySubmitted">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
                <Button x:Name="SidebarSettingsButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource MicaGoIconButtonStyle}"
                        ToolTipService.ToolTip="Settings"
                        Click="SidebarSettingsButton_Click">
                    <FontIcon FontSize="15" Glyph="&#xE713;" />
                </Button>
            </Grid>

            <ListView x:Name="ChatList"
                      Grid.Row="1"
                      Background="Transparent"
                      IsItemClickEnabled="True"
                      ItemClick="ChatList_ItemClick"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource MicaGoChatListStyle}">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatSummary">
                        <Grid MinHeight="64" Padding="10,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="42"
                                           Height="42"
                                           VerticalAlignment="Center"
                                           DisplayName="{x:Bind Title}"
                                           ProfilePicture="{x:Bind app:Ui.Image(AvatarPath)}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock HorizontalAlignment="Left"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{x:Bind Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <FontIcon Grid.Column="1"
                                              FontSize="11"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              Glyph="&#xE74F;"
                                              Visibility="{x:Bind app:Ui.BoolVisibility(IsMuted)}" />
                                </Grid>
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           MaxLines="1"
                                           Text="{x:Bind Preview}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        MinWidth="34"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Spacing="6">
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind Time}" />
                                <Border MinWidth="18"
                                        Height="18"
                                        Padding="5,0"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="9"
                                        Visibility="{x:Bind app:Ui.CountVisibility(UnreadCount)}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                               Text="{x:Bind app:Ui.CountLabel(UnreadCount)}" />
                                </Border>
                                <FontIcon HorizontalAlignment="Right"
                                          FontSize="11"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          Glyph="&#xE718;"
                                          Visibility="{x:Bind app:Ui.PinVisibility(IsPinned, UnreadCount)}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" Padding="16,0,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="#1A9B55" />
                <TextBlock x:Name="ConnectionStatusText"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Connected"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <Grid x:Name="SettingsSidebar"
              Grid.Column="0"
              Background="Transparent"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,8,12,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button VerticalAlignment="Center"
                        Style="{StaticResource MicaGoIconButtonStyle}"
                        ToolTipService.ToolTip="Back"
                        Click="SettingsBackButton_Click">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <TextBlock x:Name="SettingsSidebarTitle"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Settings" />
            </Grid>
            <ListView x:Name="SettingsNavigationList"
                      Grid.Row="1"
                      Padding="8,4"
                      SelectionMode="Single"
                      SelectionChanged="SettingsNavigationList_SelectionChanged">
                <ListViewItem Tag="general">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE771;" />
                        <TextBlock x:Name="GeneralSettingsLabel" VerticalAlignment="Center" Text="General" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="contacts">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE77B;" />
                        <TextBlock x:Name="ContactSettingsLabel" VerticalAlignment="Center" Text="Contacts" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="storage">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xEDA2;" />
                        <TextBlock x:Name="StorageSettingsLabel" VerticalAlignment="Center" Text="Storage" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Grid>

        <Border Grid.Column="0"
                Width="1"
                HorizontalAlignment="Right"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                IsHitTestVisible="False" />

        <!-- The conversation pane is a distinct rounded surface below the native title bar. -->
        <Border x:Name="ConversationPane"
                Grid.Column="1"
                Background="{ThemeResource MicaGoChatSurfaceBrush}"
                CornerRadius="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Contact information belongs to the conversation, not to the window chrome. -->
                <Border MinHeight="60"
                        Background="{ThemeResource MicaGoContactBarBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,0,0,0">
                    <Grid Padding="16,8,10,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="ThreadAvatar"
                                       Width="38"
                                       Height="38"
                                       VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock x:Name="ThreadTitle"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Select a conversation"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ThreadSubtitle"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Messages stay on this device"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource MicaGoIconButtonStyle}"
                                ToolTipService.ToolTip="Conversation info"
                                Click="ConversationInfoButton_Click">
                            <FontIcon FontSize="16" Glyph="&#xE946;" />
                        </Button>
                        <Button Grid.Column="3"
                                VerticalAlignment="Center"
                                Style="{StaticResource MicaGoIconButtonStyle}"
                                ToolTipService.ToolTip="More options"
                                Click="ConversationMoreButton_Click">
                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <Border Width="52"
                                Height="52"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="26">
                            <FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="23"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE8BD;" />
                        </Border>
                        <TextBlock x:Name="EmptyStateText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Choose a conversation to start" />
                    </StackPanel>
                    <ListView x:Name="MessageList"
                              Padding="4,14,4,8"
                              Background="Transparent"
                              IsTabStop="False"
                              ItemContainerStyle="{StaticResource MicaGoMessageListStyle}"
                              SelectionMode="None"
                              RightTapped="MessageList_RightTapped">
                        <ListView.Header>
                            <Button x:Name="LoadOlderButton"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    Content="Load earlier messages"
                                    Click="LoadOlderButton_Click" />
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Message">
                                <controls:MessageBubble />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="1" Padding="16,8,16,14">
                        <Border MinHeight="46"
                                MaxWidth="920"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource MicaGoComposerBrush}"
                                BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="23">
                            <Grid Padding="5" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AttachButton"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource MicaGoIconButtonStyle}"
                                        ToolTipService.ToolTip="Attach"
                                        Click="AttachButton_Click">
                                    <FontIcon FontSize="16" Glyph="&#xE723;" />
                                </Button>
                                <TextBox x:Name="Composer"
                                         Grid.Column="1"
                                         MinHeight="36"
                                         MaxHeight="128"
                                         Padding="8,8,8,7"
                                         VerticalAlignment="Center"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CornerRadius="0"
                                         IsEnabled="False"
                                         PlaceholderText="Message"
                                         TextWrapping="Wrap"
                                         TextChanged="Composer_TextChanged"
                                         KeyDown="Composer_KeyDown" />
                                <Button x:Name="SendButton"
                                        Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="0"
                                        CornerRadius="18"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Send"
                                        Click="SendButton_Click">
                                    <FontIcon FontSize="15"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                              Glyph="&#xE724;" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Full-screen send effects (confetti, hearts, …) play on
                         top of the whole conversation area. -->
                    <Canvas x:Name="EffectCanvas"
                            Grid.RowSpan="2"
                            IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <Frame x:Name="DetailFrame"
               Grid.Column="1"
               Background="{ThemeResource MicaGoChatSurfaceBrush}"
               Visibility="Collapsed">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition HorizontalOffset="24" />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Comfortable">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="340" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Spacious">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="380" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
