<Page
    x:Class="MicaGo.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:MicaGo.App"
    xmlns:controls="using:MicaGo.App.Controls"
    xmlns:models="using:MicaGo.Core.Models">

    <Page.Resources>
        <Flyout x:Key="HideUndoFlyoutResource" x:Name="HideUndoFlyout">
            <StackPanel Spacing="12" MaxWidth="320">
                <TextBlock x:Name="HideUndoMessage" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="HideUndoButton" Click="HideUndoButton_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Flyout>
    </Page.Resources>

    <Grid x:Name="ShellRoot" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="340" MinWidth="280" MaxWidth="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The transparent sidebar exposes the window Mica; content uses semantic layers. -->
        <Grid x:Name="ChatSidebar" Grid.Column="0" Background="Transparent">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="-24" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="ConnectionStatusRow" Height="38" />
            </Grid.RowDefinitions>

            <Grid Padding="12,8,8,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox"
                                VerticalAlignment="Center"
                                PlaceholderText="Search conversations"
                                TextMemberPath="Title"
                                TextChanged="SearchBox_TextChanged"
                                SuggestionChosen="SearchBox_SuggestionChosen"
                                QuerySubmitted="SearchBox_QuerySubmitted">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
                <Button x:Name="SidebarSettingsButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource MicaGoIconButtonStyle}"
                        ToolTipService.ToolTip="Settings"
                        Click="SidebarSettingsButton_Click">
                    <FontIcon FontSize="15" Glyph="&#xE713;" />
                </Button>
            </Grid>

            <Grid x:Name="ChatSelectionRegion" Grid.Row="1">
            <ListView x:Name="ChatList"
                      Background="Transparent"
                      IsItemClickEnabled="True"
                      ItemClick="ChatList_ItemClick"
                      RightTapped="ChatList_RightTapped"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource MicaGoChatListStyle}">
                <ListView.Resources>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatSummary">
                        <Grid MinHeight="64" Padding="10,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="42"
                                           Height="42"
                                           VerticalAlignment="Center"
                                           DisplayName="{x:Bind Title, Mode=OneWay}"
                                           ProfilePicture="{x:Bind app:Ui.Image(AvatarPath), Mode=OneWay}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock HorizontalAlignment="Left"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{x:Bind Title, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <FontIcon Grid.Column="1"
                                              FontSize="11"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              Glyph="&#xE74F;"
                                              Visibility="{x:Bind app:Ui.BoolVisibility(IsMuted), Mode=OneWay}" />
                                </Grid>
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           MaxLines="1"
                                           Text="{x:Bind Preview, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        MinWidth="34"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Spacing="6">
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind Time, Mode=OneWay}" />
                                <Border MinWidth="24"
                                        Height="22"
                                        Padding="9,0"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource MicaGoUnreadBadgeBrush}"
                                        CornerRadius="11"
                                        Visibility="{x:Bind app:Ui.CountVisibility(HasUnread, UnreadCount, IsMuted), Mode=OneWay}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource MicaGoUnreadBadgeTextBrush}"
                                               Text="{x:Bind app:Ui.CountLabel(UnreadCount), Mode=OneWay}" />
                                </Border>
                                <Ellipse Width="12"
                                         Height="12"
                                         HorizontalAlignment="Right"
                                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         Visibility="{x:Bind app:Ui.DotVisibility(HasUnread, UnreadCount, IsMuted), Mode=OneWay}" />
                                <FontIcon HorizontalAlignment="Right"
                                          FontSize="11"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          Glyph="&#xE718;"
                                          Visibility="{x:Bind app:Ui.PinVisibility(IsPinned, HasUnread), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="ChatSelectionIndicator" Width="3" Height="20"
                            CornerRadius="1.5" Visibility="Collapsed"
                            Background="{ThemeResource ListViewItemSelectionIndicatorBrush}" />
                </Canvas>
            </Grid>

            <Grid x:Name="ConnectionStatusPanel" Grid.Row="2" Padding="16,0,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="#1A9B55" />
                <TextBlock x:Name="ConnectionStatusText"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Connected"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <Grid x:Name="SettingsSidebar"
              Grid.Column="0"
              Background="Transparent"
              Visibility="Collapsed">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="24" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,8,12,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button VerticalAlignment="Center"
                        Style="{StaticResource MicaGoIconButtonStyle}"
                        x:Name="SettingsBackButton"
                        ToolTipService.ToolTip="Back"
                        Click="SettingsBackButton_Click">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <TextBlock x:Name="SettingsSidebarTitle"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Settings" />
            </Grid>
            <Grid x:Name="SettingsSelectionRegion" Grid.Row="1">
            <ListView x:Name="SettingsNavigationList"
                      Padding="8,4"
                      ItemContainerStyle="{StaticResource MicaGoSettingsNavigationItemStyle}"
                      SelectionMode="Single"
                      SelectionChanged="SettingsNavigationList_SelectionChanged">
                <ListView.Resources>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                    <CornerRadius x:Key="ListViewItemCornerRadius">4</CornerRadius>
                </ListView.Resources>
                    <ListViewItem Tag="general">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                            <TextBlock x:Name="GeneralSettingsLabel" VerticalAlignment="Center" Text="General" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="appearance">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE771;" />
                            <TextBlock x:Name="AppearanceSettingsLabel" VerticalAlignment="Center" Text="Appearance" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="notifications">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xEA8F;" />
                            <TextBlock x:Name="ContactSettingsLabel" VerticalAlignment="Center" Text="Notifications" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="data">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xEDA2;" />
                            <TextBlock x:Name="StorageSettingsLabel" VerticalAlignment="Center" Text="Data" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="about">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE946;" />
                            <TextBlock x:Name="AboutSettingsLabel" VerticalAlignment="Center" Text="About" />
                        </StackPanel>
                    </ListViewItem>
            </ListView>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="SettingsSelectionIndicator" Width="3" Height="20"
                            CornerRadius="1.5" Visibility="Collapsed"
                            Background="{ThemeResource ListViewItemSelectionIndicatorBrush}" />
                </Canvas>
            </Grid>
        </Grid>

        <!-- Match WinUI NavigationView's native content surface: one rounded,
             bordered layer owns both the conversation and secondary pages. -->
        <Border x:Name="ContentSurface"
                Grid.Column="1"
                Background="{ThemeResource MicaGoChatSurfaceBrush}"
                BackgroundSizing="InnerBorderEdge"
                BorderBrush="{ThemeResource NavigationViewContentGridBorderBrush}"
                BorderThickness="{ThemeResource NavigationViewContentGridBorderThickness}"
                CornerRadius="{ThemeResource NavigationViewContentGridCornerRadius}">
            <Grid>
                <Grid x:Name="ConversationPane" AllowDrop="True" DragOver="Thread_DragOver" Drop="Thread_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="-32" IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </Grid.Transitions>
                    <!-- The header is separate; the floating editor overlays the canvas. -->
                    <Border Grid.Row="0" MinHeight="64"
                            Background="{ThemeResource MicaGoContactBarBrush}"
                            BackgroundSizing="InnerBorderEdge"
                            BorderBrush="{ThemeResource NavigationViewContentGridBorderBrush}"
                            BorderThickness="0,0,0,1">
                    <Grid Padding="16,8,10,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ThreadIdentityButton" Grid.ColumnSpan="2"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                CornerRadius="4" Click="ConversationMoreButton_Click">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="ThreadAvatar"
                                       Width="38"
                                       Height="38"
                                       VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock x:Name="ThreadTitle"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       Text="Select a conversation"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ThreadSubtitle"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text=""
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        </Grid>
                        </Button>
                        <Button x:Name="ThreadDetailsButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource MicaGoIconButtonStyle}"
                                ToolTipService.ToolTip="Conversation details"
                                Click="ConversationMoreButton_Click">
                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                    <Image x:Name="ChatBackgroundImage"
                           Stretch="UniformToFill"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
                    <!-- W-UI8: Flutter's wash over a custom background keeps text readable. -->
                    <Border x:Name="ChatBackgroundScrim"
                            Background="{ThemeResource MicaGoChatBackgroundScrimBrush}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <Border Width="52"
                                Height="52"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="26">
                            <FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="23"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE8BD;" />
                        </Border>
                        <TextBlock x:Name="EmptyStateText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Choose a conversation to start" />
                    </StackPanel>
                    <ListView x:Name="MessageList" AllowDrop="True" DragOver="Thread_DragOver" Drop="Thread_Drop"
                              Padding="20,12,20,16"
                              Background="Transparent"
                              IsTabStop="True"
                              KeyDown="MessageList_KeyDown"
                              ItemContainerStyle="{StaticResource MicaGoMessageListStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None"
                              Loaded="MessageList_Loaded"
                              ContainerContentChanging="MessageList_ContainerContentChanging"
                              ContextRequested="MessageList_ContextRequested">
                        <!-- Entrance is collection-reason + viewport gated in code.
                             Generic transitions also run for snapshots and recycling. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Chat behavior: stay pinned to the newest
                                     message while appends arrive at the bottom. -->
                                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.Header>
                            <ProgressRing x:Name="OlderMessagesProgress"
                                          Width="20" Height="20" Margin="0,0,0,10"
                                          HorizontalAlignment="Center"
                                          IsActive="False" Visibility="Collapsed" />
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MessageRow">
                                <controls:MessageBubble Message="{x:Bind Value, Mode=OneWay}"
                                                        MessageContextRequested="MessageText_ContextMenuOpening" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button x:Name="JumpToBottomButton"
                            Width="40"
                            Height="40"
                            Margin="0,0,16,16"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource MicaGoChatCardBrush}"
                            BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}"
                            BorderThickness="1"
                            Canvas.ZIndex="2"
                            CornerRadius="4"
                            Visibility="Collapsed"
                            Click="JumpToBottomButton_Click">
                        <FontIcon FontSize="14" Glyph="&#xE74B;" />
                    </Button>

                    <!-- Full-screen send effects (confetti, hearts, …) play on
                         top of the whole conversation area. -->
                    <Canvas x:Name="EffectCanvas"
                            IsHitTestVisible="False" />
                    </Grid>
                    <Border x:Name="ComposerRegion" Grid.Row="1" VerticalAlignment="Bottom"
                            Margin="12,0,12,12" SizeChanged="ComposerRegion_SizeChanged">
                    <Grid>
                        <!-- Flutter's attachment + inset editor + separate send action,
                             floating over the canvas with native TextBox focus/IME. -->
                        <Grid x:Name="ComposerBorder" MaxWidth="920" ColumnSpacing="8">
                            <Grid.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="8" IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </Grid.Transitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource MicaGoComposerAcrylicBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="28" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AttachButton"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource MicaGoComposerGlyphButtonStyle}"
                                            ToolTipService.ToolTip="Attach">
                                        <FontIcon FontSize="20" Glyph="&#xE710;" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                                <MenuFlyoutItem x:Name="AttachFilesItem" Text="Choose files…" Click="AttachFilesItem_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE723;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Name="RecordVoiceItem" Text="Record voice message" IsEnabled="False" Click="RecordVoiceItem_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE720;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBox x:Name="Composer" Grid.Column="1"
                                             MinHeight="48" MaxHeight="144" FontSize="16"
                                             Padding="14,10" Margin="0,0,4,0"
                                             Background="Transparent"
                                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                             AcceptsReturn="True" CornerRadius="24" IsEnabled="False"
                                             PlaceholderText="Message" TextWrapping="Wrap"
                                             TextChanged="Composer_TextChanged" Paste="Composer_Paste"
                                             PreviewKeyDown="Composer_KeyDown">
                                        <TextBox.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.ThemeDictionaries>
                                                    <ResourceDictionary x:Key="Default">
                                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#10FFFFFF" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#10FFFFFF" />
                                                    </ResourceDictionary>
                                                    <ResourceDictionary x:Key="Light">
                                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#18FFFFFF" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#18FFFFFF" />
                                                    </ResourceDictionary>
                                                    <ResourceDictionary x:Key="HighContrast">
                                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SystemColorWindowColor}" />
                                                    </ResourceDictionary>
                                                </ResourceDictionary.ThemeDictionaries>
                                            </ResourceDictionary>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <Button x:Name="EmojiButton" Grid.Column="2"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource MicaGoComposerGlyphButtonStyle}"
                                            ToolTipService.ToolTip="Emoji" IsEnabled="False"
                                            Click="EmojiButton_Click">
                                        <FontIcon FontSize="22" Glyph="&#xE899;" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="1" Width="52" Height="52" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                  CornerRadius="26" Background="{ThemeResource MicaGoSendAcrylicBrush}">
                            <Button x:Name="SendButton"
                                    Width="52" Height="52" Padding="0" CornerRadius="26"
                                    Background="Transparent"
                                    Foreground="{ThemeResource MicaGoSendMaterialForegroundBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    IsEnabled="False" ToolTipService.ToolTip="Send" Click="SendButton_Click">
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.20" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.28" />
                                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#08000000" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Default">
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.32" />
                                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#08FFFFFF" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="HighContrast">
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                                <FontIcon FontSize="20" Glyph="&#xE724;" />
                            </Button>
                            </Grid>
                        </Grid>

                        <!-- Voice recording bar (swaps in for the composer). -->
                        <Border x:Name="VoiceBar"
                                MinHeight="46"
                                MaxWidth="920"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource MicaGoComposerBrush}"
                                BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                            <Border.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="8" IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </Border.Transitions>
                            <Grid Padding="14,5,5,5" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10"
                                         Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock x:Name="VoiceTimerText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="0:00" />
                                <Button x:Name="VoiceCancelButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="Cancel"
                                        Click="VoiceCancelButton_Click" />
                                <Button x:Name="VoiceSendButton"
                                        Grid.Column="3"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Click="VoiceSendButton_Click">
                                    <FontIcon FontSize="15"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                              Glyph="&#xE724;" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Multi-select action bar (swaps in for the composer). -->
                        <Border x:Name="SelectionBar"
                                MinHeight="46"
                                MaxWidth="920"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource MicaGoComposerBrush}"
                                BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                            <Border.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="8" IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </Border.Transitions>
                            <Grid Padding="14,5,5,5" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectionCountText"
                                           VerticalAlignment="Center"
                                           FontSize="13" />
                                <Button x:Name="SelectionForwardButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="Forward"
                                        Click="SelectionForwardButton_Click" />
                                <Button x:Name="SelectionHideButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="Hide"
                                        Click="SelectionHideButton_Click" />
                                <Button x:Name="SelectionCancelButton"
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MicaGoIconButtonStyle}"
                                        Click="SelectionCancelButton_Click">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    </Border>

                </Grid>

                <Frame x:Name="DetailFrame"
                       Background="Transparent"
                       Visibility="Collapsed">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </Border>

        <controls:SidebarResizeGrip Grid.Column="1"
                                    Width="12"
                                    Margin="-6,0,0,0"
                                    HorizontalAlignment="Left"
                                    Canvas.ZIndex="20"
                                    Style="{StaticResource MicaGoSidebarResizeGripStyle}"
                                    PointerPressed="SidebarResizeGrip_PointerPressed"
                                    PointerMoved="SidebarResizeGrip_PointerMoved"
                                    PointerReleased="SidebarResizeGrip_PointerReleased"
                                    PointerCanceled="SidebarResizeGrip_PointerCanceled"
                                    PointerCaptureLost="SidebarResizeGrip_PointerCaptureLost" />

    </Grid>
</Page>
