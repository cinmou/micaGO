<Page
    x:Class="MicaGo.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styled after the Windows 11 Settings app: a large page title and one
         card per setting (icon | title + description | trailing control). -->
    <Grid Background="Transparent">
        <ScrollViewer>
            <Grid MaxWidth="1000" Margin="36,12,36,40" HorizontalAlignment="Stretch">

                <StackPanel x:Name="GeneralSection" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <TextBlock x:Name="ConnectionHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Connection" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE968;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ConnectionTitle" Text="micaGO server" />
                                <TextBlock x:Name="ConnectionSubtitle"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Not connected"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="DisconnectButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="Disconnect"
                                    Click="DisconnectButton_Click" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="BehaviorHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Notifications" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEA8F;" />
                            <TextBlock x:Name="NotificationLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Show new-message notifications" />
                            <ToggleSwitch x:Name="NotificationToggle"
                                          Grid.Column="2"
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          OffContent=""
                                          OnContent=""
                                          Toggled="NotificationToggle_Toggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE7F4;" />
                            <TextBlock x:Name="TrayLabel" Grid.Column="1" VerticalAlignment="Center" Text="Keep micaGO in the system tray" />
                            <ToggleSwitch x:Name="TrayToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="TrayToggle_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="BackupHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Backup &amp; restore" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE777;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="BackupLabel" Text="Settings backup (.micagobak)" />
                                <TextBlock x:Name="BackupStatus"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ExportBackupButton" Content="Export…" Click="ExportBackupButton_Click" />
                                <Button x:Name="ImportBackupButton" Content="Import…" Click="ImportBackupButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TestingHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Testing" />
                    <Border x:Name="TestContactCard" Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEBE8;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="TestContactLabel" Text="Offline test contact" />
                                <TextBlock x:Name="TestContactHint"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TestContactToggle"
                                          Grid.Column="2"
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          OffContent=""
                                          OnContent=""
                                          Toggled="TestContactToggle_Toggled" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AppearanceSection" Spacing="4" Visibility="Collapsed">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <TextBlock x:Name="AppearanceHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Appearance" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE790;" />
                            <TextBlock x:Name="ThemeLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Theme" />
                            <ComboBox x:Name="ThemePicker"
                                      Grid.Column="2"
                                      MinWidth="180"
                                      VerticalAlignment="Center"
                                      SelectionChanged="ThemePicker_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE7C1;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="TwemojiFlagsLabel" Text="Use Twemoji for flags" />
                                <TextBlock x:Name="TwemojiFlagsDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TwemojiFlagsToggle"
                                          Grid.Column="2"
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          OffContent=""
                                          OnContent=""
                                          Toggled="TwemojiFlagsToggle_Toggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xF2B7;" />
                            <TextBlock x:Name="LanguageLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Language" />
                            <ComboBox x:Name="LanguagePicker"
                                      Grid.Column="2"
                                      MinWidth="180"
                                      VerticalAlignment="Center"
                                      SelectionChanged="LanguagePicker_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="简体中文" />
                                <ComboBoxItem Content="繁體中文" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEB9F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ChatBackgroundLabel" Text="Chat background" />
                                <TextBlock x:Name="ChatBackgroundStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ChooseBackgroundButton" Content="Choose…" Click="ChooseBackgroundButton_Click" />
                                <Button x:Name="ClearBackgroundButton" Content="Clear" Click="ClearBackgroundButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE2B1;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="BubbleColorLabel" Text="Outgoing bubble color" />
                                <TextBlock x:Name="BubbleFollowSystemLabel"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Follow system accent" />
                            </StackPanel>
                            <ToggleSwitch x:Name="BubbleFollowSystemToggle"
                                          Grid.Column="2"
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          OffContent=""
                                          OnContent=""
                                          Toggled="BubbleFollowSystemToggle_Toggled" />
                        </Grid>
                    </Border>
                    <Border x:Name="BubbleColorCard" Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE790;" />
                            <TextBlock x:Name="BubbleColorPickLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Custom color" />
                            <Button x:Name="BubbleColorButton" Grid.Column="2" VerticalAlignment="Center" Content="Choose…">
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="BubbleColorPicker" IsAlphaEnabled="False" ColorSpectrumShape="Ring" ColorChanged="BubbleColorPicker_ColorChanged" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ContactsSection" Spacing="4" Visibility="Collapsed">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <TextBlock x:Name="ContactsHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Contacts" />
                    <TextBlock x:Name="ContactsHint"
                               Margin="1,0,0,8"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEDE1;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ImportVcfLabel" Text="Import contacts from vCard" />
                                <TextBlock x:Name="VcfImportStatus"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ImportVcfButton"
                                        VerticalAlignment="Center"
                                        Content="Browse…"
                                        Click="ImportVcfButton_Click" />
                                <Button x:Name="ClearVcfButton"
                                        VerticalAlignment="Center"
                                        Content="Clear all"
                                        Click="ClearVcfButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="HiddenContactsButton"
                            MinHeight="64"
                            Padding="16,12"
                            HorizontalContentAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Click="HiddenContactsButton_Click">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE77B;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="HiddenContactsLabel" Text="Hidden contacts" />
                                <TextBlock x:Name="HiddenContactsStatus"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="StorageSection" Spacing="4" Visibility="Collapsed">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <TextBlock x:Name="StorageHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Storage" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEDA2;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Media and message cache" />
                                <TextBlock x:Name="ClearCacheHint"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Remove locally cached data from this PC." />
                            </StackPanel>
                            <Button x:Name="ClearCacheButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="Clear cache"
                                    Click="ClearCacheButton_Click" />
                        </Grid>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="AboutSection" Spacing="4" Visibility="Collapsed">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <TextBlock x:Name="AboutHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="About" />
                    <Border Padding="20,16" Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="56"
                                   Height="56"
                                   VerticalAlignment="Center"
                                   Source="ms-appx:///Assets/micaGO.Windows.png" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="micaGO" />
                                <TextBlock x:Name="AboutSubtitleText"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AboutVersionText"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE774;" />
                            <TextBlock x:Name="AboutGitHubLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="View the project on GitHub" />
                            <HyperlinkButton x:Name="AboutGitHubLink"
                                             Grid.Column="2"
                                             VerticalAlignment="Center"
                                             Content="github.com/cinmou/MicaGo"
                                             NavigateUri="https://github.com/cinmou/MicaGo" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Top" Margin="0,3,0,0" FontSize="18" Glyph="&#xE90F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="AboutOpenSourceLabel" FontWeight="SemiBold" Text="Open source &amp; attributions" />
                                <TextBlock x:Name="AboutAttributionText"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AboutDisclaimerText"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
