<Page
    x:Class="MicaGo.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styled after the Windows 11 Settings app: a large page title and one
         card per setting (icon | title + description | trailing control). -->
    <Grid Background="{ThemeResource MicaGoSecondaryPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource MicaGoPageHeaderBackgroundBrush}"
                BackgroundSizing="InnerBorderEdge"
                BorderBrush="{ThemeResource NavigationViewContentGridBorderBrush}"
                BorderThickness="0,0,0,1" />

        <Grid MaxWidth="1000" Padding="36,24,36,12" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource MicaGoIconButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    Click="BackButton_Click">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock x:Name="PageTitle"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource MicaGoPageHeaderForegroundBrush}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="General" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <Grid MaxWidth="1000" Margin="36,0,36,40" HorizontalAlignment="Stretch">

                <StackPanel x:Name="GeneralSection" Spacing="4">
                    <TextBlock x:Name="ConnectionHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Connection" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE968;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ConnectionTitle" Text="micaGO server" />
                                <TextBlock x:Name="ConnectionSubtitle"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Not connected"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="DisconnectButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="Disconnect"
                                    Click="DisconnectButton_Click" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="BehaviorHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Notifications" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEA8F;" />
                            <TextBlock x:Name="NotificationLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Show new-message notifications" />
                            <ToggleSwitch x:Name="NotificationToggle"
                                          Grid.Column="2"
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          OffContent=""
                                          OnContent=""
                                          Toggled="NotificationToggle_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="AppearanceHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Appearance" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE790;" />
                            <TextBlock x:Name="ThemeLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Theme" />
                            <ComboBox x:Name="ThemePicker"
                                      Grid.Column="2"
                                      MinWidth="180"
                                      VerticalAlignment="Center"
                                      SelectionChanged="ThemePicker_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xF2B7;" />
                            <TextBlock x:Name="LanguageLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Language" />
                            <ComboBox x:Name="LanguagePicker"
                                      Grid.Column="2"
                                      MinWidth="180"
                                      VerticalAlignment="Center"
                                      SelectionChanged="LanguagePicker_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="简体中文" />
                                <ComboBoxItem Content="繁體中文" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ContactsSection" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="ContactsHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Contacts" />
                    <TextBlock x:Name="ContactsHint"
                               Margin="1,0,0,8"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEDE1;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ImportCsvLabel" Text="Import contacts from CSV" />
                                <TextBlock x:Name="CsvImportStatus"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ImportCsvButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="Browse…"
                                    Click="ImportCsvButton_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE77B;" />
                                <TextBlock VerticalAlignment="Center" Text="Google Contacts" />
                            </Grid>
                            <TextBox x:Name="GoogleClientId" PlaceholderText="OAuth desktop client ID" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="GoogleSignInButton" Content="Sign in" Click="GoogleSignInButton_Click" />
                                <Button x:Name="GoogleSyncButton" Content="Sync" Click="GoogleSyncButton_Click" />
                                <Button x:Name="GoogleSignOutButton" Content="Sign out" Click="GoogleSignOutButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="GoogleStatus"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StorageSection" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="StorageHeader"
                               Style="{StaticResource MicaGoSettingsHeaderStyle}"
                               Text="Storage" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEDA2;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Media and message cache" />
                                <TextBlock x:Name="ClearCacheHint"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Remove locally cached data from this PC." />
                            </StackPanel>
                            <Button x:Name="ClearCacheButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="Clear cache"
                                    Click="ClearCacheButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
