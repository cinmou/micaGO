<Page
    x:Class="MicaGo.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid MaxWidth="1000" Margin="36,12,36,40" HorizontalAlignment="Stretch">
                <StackPanel x:Name="GeneralSection" Spacing="4">
                    <TextBlock x:Name="ConnectionHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}" Text="Connection" />
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE968;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="ConnectionTitle" Text="micaGO server"/><TextBlock x:Name="ConnectionSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="Not connected"/></StackPanel><Button x:Name="DisconnectButton" Grid.Column="2" Content="Disconnect" Click="DisconnectButton_Click"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="BehaviorHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}" Text="General"/>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE7F4;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="TrayLabel"/><TextBlock x:Name="TrayDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="TrayToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="TrayToggle_Toggled"/></Grid></Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xF2B7;"/><TextBlock x:Name="LanguageLabel" Grid.Column="1" VerticalAlignment="Center"/><ComboBox x:Name="LanguagePicker" Grid.Column="2" MinWidth="180" SelectionChanged="LanguagePicker_SelectionChanged"><ComboBoxItem Content="System"/><ComboBoxItem Content="English"/><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="繁體中文"/></ComboBox></Grid></Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE8BD;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="SmsLabel"/><TextBlock x:Name="SmsDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="SmsToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="SmsToggle_Toggled"/></Grid></Border>
                </StackPanel>

                <StackPanel x:Name="AppearanceSection" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="AppearanceHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}"/>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE790;"/><TextBlock x:Name="ThemeLabel" Grid.Column="1" VerticalAlignment="Center"/><ComboBox x:Name="ThemePicker" Grid.Column="2" MinWidth="180" SelectionChanged="ThemePicker_SelectionChanged"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></Grid></Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEB9F;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="ChatBackgroundLabel"/><TextBlock x:Name="ChatBackgroundStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button x:Name="ChooseBackgroundButton" Click="ChooseBackgroundButton_Click"/><Button x:Name="ClearBackgroundButton" Click="ClearBackgroundButton_Click"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE2B1;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="BubbleColorLabel"/><TextBlock x:Name="BubbleFollowSystemLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="BubbleFollowSystemToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="BubbleFollowSystemToggle_Toggled"/></Grid></Border>
                    <Border x:Name="BubbleColorCard" Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE790;"/><TextBlock x:Name="BubbleColorPickLabel" Grid.Column="1" VerticalAlignment="Center"/><Button x:Name="BubbleColorButton" Grid.Column="2"><Button.Flyout><Flyout><ColorPicker x:Name="BubbleColorPicker" IsAlphaEnabled="False" ColorSpectrumShape="Ring" ColorChanged="BubbleColorPicker_ColorChanged"/></Flyout></Button.Flyout></Button></Grid></Border>
                    <TextBlock x:Name="EmojiHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}"/>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE7C1;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="TwemojiFlagsLabel"/><TextBlock x:Name="TwemojiFlagsDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="TwemojiFlagsToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="TwemojiFlagsToggle_Toggled"/></Grid></Border>
                </StackPanel>

                <StackPanel x:Name="NotificationSection" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="NotificationsHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}"/>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEA8F;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="NotificationLabel"/><TextBlock x:Name="NotificationDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="NotificationToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="NotificationToggle_Toggled"/></Grid></Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE8C3;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="NotificationPreviewLabel"/><TextBlock x:Name="NotificationPreviewDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="NotificationPreviewToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="NotificationPreviewToggle_Toggled"/></Grid></Border>
                    <InfoBar x:Name="NotificationInfo" IsOpen="True" IsClosable="False" Severity="Informational"/>
                </StackPanel>

                <StackPanel x:Name="DataSection" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="ContactsHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}"/><TextBlock x:Name="ContactsHint" Margin="1,0,0,8" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEDE1;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="ImportVcfLabel"/><TextBlock x:Name="VcfImportStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button x:Name="ImportVcfButton" Click="ImportVcfButton_Click"/><Button x:Name="ClearVcfButton" Click="ClearVcfButton_Click"/></StackPanel></Grid></Border>
                    <Button x:Name="HiddenMessagesButton" MinHeight="64" Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Click="HiddenMessagesButton_Click"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE8F2;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="HiddenMessagesLabel"/><TextBlock x:Name="HiddenMessagesStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;"/></Grid></Button>
                    <Button x:Name="HiddenContactsButton" MinHeight="64" Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Click="HiddenContactsButton_Click"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE77B;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="HiddenContactsLabel"/><TextBlock x:Name="HiddenContactsStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;"/></Grid></Button>
                    <TextBlock x:Name="BackupHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}"/>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE777;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="BackupLabel"/><TextBlock x:Name="BackupStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button x:Name="ExportBackupButton" Click="ExportBackupButton_Click"/><Button x:Name="ImportBackupButton" Click="ImportBackupButton_Click"/></StackPanel></Grid></Border>
                    <TextBlock x:Name="StorageHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}"/>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEDA2;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="CacheLabel"/><TextBlock x:Name="ClearCacheHint" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Button x:Name="ClearCacheButton" Grid.Column="2" Click="ClearCacheButton_Click"/></Grid></Border>
                </StackPanel>

                <StackPanel x:Name="AboutSection" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="AboutHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}"/>
                    <Border x:Name="AboutIdentity" Padding="20,16" Style="{StaticResource MicaGoSettingsCardStyle}" Tapped="AboutIdentity_Tapped"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Width="56" Height="56" Source="ms-appx:///Assets/micaGO.Windows.png"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontSize="18" FontWeight="SemiBold" Text="micaGO"/><TextBlock x:Name="AboutSubtitleText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="AboutVersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE774;"/><TextBlock x:Name="AboutGitHubLabel" Grid.Column="1" VerticalAlignment="Center"/><HyperlinkButton x:Name="AboutGitHubLink" Grid.Column="2" Content="github.com/cinmou/MicaGo" NavigateUri="https://github.com/cinmou/MicaGo"/></Grid></Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE895;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="AboutUpdateLabel"/><TextBlock x:Name="AboutUpdateStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button x:Name="AboutUpdateButton" Grid.Column="2" Click="CheckForUpdates_Click"/></Grid></Border>
                    <Border Style="{StaticResource MicaGoSettingsCardStyle}"><Expander HorizontalAlignment="Stretch"><Expander.Header><StackPanel><TextBlock x:Name="AboutOpenSourceLabel" FontWeight="SemiBold"/><TextBlock x:Name="AboutAttributionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Expander.Header><TextBlock x:Name="AboutDisclaimerText" Margin="0,8,0,4" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/></Expander></Border>
                    <StackPanel x:Name="DeveloperPanel" Spacing="4" Visibility="Collapsed"><TextBlock x:Name="TestingHeader" Style="{StaticResource MicaGoSettingsHeaderStyle}"/><Border x:Name="TestContactCard" Style="{StaticResource MicaGoSettingsCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xEBE8;"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="TestContactLabel"/><TextBlock x:Name="TestContactHint" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="TestContactToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="TestContactToggle_Toggled"/></Grid></Border></StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
