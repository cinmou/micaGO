<Page
    x:Class="MicaGo.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource MicaGoThreadBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MicaGoIconButtonStyle}" ToolTipService.ToolTip="Back" Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Settings" />
        </Grid>
        <Rectangle Grid.Row="1" Fill="{ThemeResource MicaGoDividerBrush}" />

        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="680" Margin="24" HorizontalAlignment="Stretch" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="Connection" />
                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;" Foreground="{StaticResource MicaGoAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="ConnectionTitle" FontWeight="SemiBold" Text="micaGO server" />
                                <TextBlock x:Name="ConnectionSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="Not connected" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Disconnect" Click="DisconnectButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="Windows behavior" />
                    <Border Padding="16,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Grid MinHeight="52">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Keep running in notification area" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="Required for local notifications after closing the window" /></StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="True" IsEnabled="False" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource MicaGoDividerBrush}" />
                            <Grid MinHeight="52">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Show message content in notifications" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="Hide previews for private notifications" /></StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="True" IsEnabled="False" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="Appearance" />
                    <Border Padding="16,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid MinHeight="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Theme" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="Follow Windows by default" /></StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" /></ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="micaGO Windows · MVP shell" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
