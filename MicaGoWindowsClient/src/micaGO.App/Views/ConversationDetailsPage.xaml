<Page
    x:Class="MicaGo.App.Views.ConversationDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Settings-style detail page: hero identity block, then one
         card per option, then the shared-media grid. -->
    <Grid Background="{ThemeResource MicaGoChatSurfaceBrush}">
        <ScrollViewer>
            <StackPanel MaxWidth="1000" Margin="36,12,36,40" HorizontalAlignment="Stretch" Spacing="4">

                <Border Padding="24,20" Style="{StaticResource MicaGoSettingsCardStyle}">
                    <Grid>
                        <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                                Style="{StaticResource MicaGoIconButtonStyle}"
                                ToolTipService.ToolTip="Back" Click="BackButton_Click">
                            <FontIcon FontSize="16" Glyph="&#xE72B;" />
                        </Button>
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <PersonPicture x:Name="HeroAvatar" Width="88" Height="88" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TitleText" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="ServiceText" HorizontalAlignment="Center" Foreground="{ThemeResource MicaGoPageHeaderSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="ConversationHeader"
                           Style="{StaticResource MicaGoSettingsHeaderStyle}"
                           Text="Conversation" />
                <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE74F;" />
                        <TextBlock x:Name="MuteLabel"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Mute notifications" />
                        <ToggleSwitch x:Name="MuteToggle"
                                      Grid.Column="2"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      OffContent=""
                                      OnContent=""
                                      Toggled="MuteToggle_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE718;" />
                        <TextBlock x:Name="PinLabel"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Pin conversation" />
                        <ToggleSwitch x:Name="PinToggle"
                                      Grid.Column="2"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      OffContent=""
                                      OnContent=""
                                      Toggled="PinToggle_Toggled" />
                    </Grid>
                </Border>

                <TextBlock x:Name="ParticipantsHeader"
                           Style="{StaticResource MicaGoSettingsHeaderStyle}"
                           Text="Participants" />
                <Border Style="{StaticResource MicaGoSettingsCardStyle}">
                    <ItemsControl x:Name="ParticipantsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE77B;" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock x:Name="MediaHeader"
                           Style="{StaticResource MicaGoSettingsHeaderStyle}"
                           Text="Shared media" />
                <ItemsControl x:Name="MediaList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,8,8" ToolTipService.ToolTip="{Binding Label}">
                                <Rectangle Width="148"
                                           Height="112"
                                           Fill="{Binding PreviewBrush}"
                                           RadiusX="8"
                                           RadiusY="8" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
