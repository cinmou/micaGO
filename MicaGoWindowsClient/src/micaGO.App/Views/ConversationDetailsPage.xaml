<Page
    x:Class="MicaGo.App.Views.ConversationDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource MicaGoChatSurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource MicaGoIconButtonStyle}" Click="BackButton_Click"><FontIcon Glyph="&#xE72B;" /></Button>
            <TextBlock x:Name="PageTitle" Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Conversation details" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="720" Margin="24" Spacing="16">
                <Border Padding="20" Background="{ThemeResource MicaGoContactBarBrush}" BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}" BorderThickness="1" CornerRadius="14">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border Width="72" Height="72" Background="{StaticResource MicaGoAccentBrush}" CornerRadius="36"><TextBlock x:Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="22" FontWeight="SemiBold" /></Border>
                        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="ServiceText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ParticipantsHeader" FontSize="13" FontWeight="SemiBold" Text="Participants" />
                <Border Padding="16" Background="{ThemeResource MicaGoContactBarBrush}" BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}" BorderThickness="1" CornerRadius="12"><ItemsControl x:Name="ParticipantsList" /></Border>
                <TextBlock x:Name="ConversationHeader" FontSize="13" FontWeight="SemiBold" Text="Conversation" />
                <Border Padding="16,8" Background="{ThemeResource MicaGoContactBarBrush}" BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <ToggleSwitch x:Name="MuteToggle" Header="Mute notifications" Toggled="MuteToggle_Toggled" />
                        <ToggleSwitch x:Name="PinToggle" Header="Pin conversation" Toggled="PinToggle_Toggled" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MediaHeader" FontSize="13" FontWeight="SemiBold" Text="Shared media" />
                <ItemsControl x:Name="MediaList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Width="148" Height="112" Margin="0,0,8,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10"><Grid><Image Source="{Binding Preview}" Stretch="UniformToFill"/><TextBlock Margin="8" VerticalAlignment="Bottom" Foreground="White" Text="{Binding Label}" TextTrimming="CharacterEllipsis"><TextBlock.Shadow><ThemeShadow/></TextBlock.Shadow></TextBlock></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
