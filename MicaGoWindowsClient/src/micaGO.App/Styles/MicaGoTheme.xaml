<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MicaGoSidebarBrush" Color="#DDF7F7F7" />
            <SolidColorBrush x:Key="MicaGoThreadBrush" Color="#B3FCFCFC" />
            <SolidColorBrush x:Key="MicaGoDividerBrush" Color="#16000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MicaGoSidebarBrush" Color="#D51F1F1F" />
            <SolidColorBrush x:Key="MicaGoThreadBrush" Color="#B31B1B1B" />
            <SolidColorBrush x:Key="MicaGoDividerBrush" Color="#20FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MicaGoSidebarBrush" Color="#DDF7F7F7" />
            <SolidColorBrush x:Key="MicaGoThreadBrush" Color="#B3FCFCFC" />
            <SolidColorBrush x:Key="MicaGoDividerBrush" Color="#16000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="MicaGoAccentColor">#1877D2</Color>
    <SolidColorBrush x:Key="MicaGoAccentBrush" Color="{StaticResource MicaGoAccentColor}" />

    <Style x:Key="MicaGoIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="MicaGoChatListStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="68" />
    </Style>
</ResourceDictionary>
