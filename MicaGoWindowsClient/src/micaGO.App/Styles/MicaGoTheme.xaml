         accent selection pill on the left edge (native ListViewItemPresenter
         selection indicator). -->
    <Style x:Key="MicaGoChatListStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
