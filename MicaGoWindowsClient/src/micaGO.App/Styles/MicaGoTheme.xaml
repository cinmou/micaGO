<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MicaGo.App.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MicaGoMessageSelectedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
            <SolidColorBrush x:Key="MicaGoMessageSelectedPointerBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
            <AcrylicBrush x:Key="MicaGoComposerAcrylicBrush" TintColor="#FFFFFF" TintOpacity="0.40" TintLuminosityOpacity="0.65" FallbackColor="#F5F5F5" />
            <AcrylicBrush x:Key="MicaGoSendAcrylicBrush" TintColor="{ThemeResource SystemAccentColorLight2}" TintOpacity="0.18" TintLuminosityOpacity="0.72" FallbackColor="#F0ECF4" />
            <StaticResource x:Key="MicaGoSendMaterialForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <SolidColorBrush x:Key="MicaGoUnreadBadgeBrush" Color="#FFFF3B30" />
            <SolidColorBrush x:Key="MicaGoUnreadBadgeTextBrush" Color="White" />
            <StaticResource x:Key="MicaGoChatSurfaceBrush"
                            ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
            <StaticResource x:Key="MicaGoContactBarBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="MicaGoSecondaryPageBrush" ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
            <StaticResource x:Key="MicaGoPageHeaderBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <SolidColorBrush x:Key="MicaGoPageHeaderForegroundBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="MicaGoPageHeaderSecondaryBrush" Color="#99000000" />
            <SolidColorBrush x:Key="MicaGoIncomingMessageBrush" Color="#E6FFFFFF" />
            <StaticResource x:Key="MicaGoComposerBrush"
                            ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="MicaGoSubtleStrokeBrush" Color="#12000000" />
            <!-- W-UI8: chips/cards in the thread. Same values as SubtleFillColorSecondary /
                 CardBackgroundFillColorDefault; ChatSurfaceBrushes turns them solid
                 while a custom chat background is set. -->
            <SolidColorBrush x:Key="MicaGoChatChipBrush" Color="#09000000" />
            <SolidColorBrush x:Key="MicaGoChatCardBrush" Color="#B3FFFFFF" />
            <!-- Flutter _ChatBackground: white 30% over the picked image. -->
            <SolidColorBrush x:Key="MicaGoChatBackgroundScrimBrush" Color="#4DFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MicaGoMessageSelectedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
            <SolidColorBrush x:Key="MicaGoMessageSelectedPointerBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
            <AcrylicBrush x:Key="MicaGoComposerAcrylicBrush" TintColor="#202020" TintOpacity="0.45" TintLuminosityOpacity="0.60" FallbackColor="#303030" />
            <AcrylicBrush x:Key="MicaGoSendAcrylicBrush" TintColor="{ThemeResource SystemAccentColorDark2}" TintOpacity="0.20" TintLuminosityOpacity="0.60" FallbackColor="#303030" />
            <StaticResource x:Key="MicaGoSendMaterialForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <SolidColorBrush x:Key="MicaGoUnreadBadgeBrush" Color="#FFFF3B30" />
            <SolidColorBrush x:Key="MicaGoUnreadBadgeTextBrush" Color="White" />
            <StaticResource x:Key="MicaGoChatSurfaceBrush"
                            ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
            <StaticResource x:Key="MicaGoContactBarBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="MicaGoSecondaryPageBrush" ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
            <StaticResource x:Key="MicaGoPageHeaderBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <SolidColorBrush x:Key="MicaGoPageHeaderForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MicaGoPageHeaderSecondaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="MicaGoIncomingMessageBrush" Color="#E6333333" />
            <StaticResource x:Key="MicaGoComposerBrush"
                            ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <SolidColorBrush x:Key="MicaGoSubtleStrokeBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="MicaGoChatChipBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="MicaGoChatCardBrush" Color="#0DFFFFFF" />
            <!-- Flutter _ChatBackground: black 38% over the picked image. -->
            <SolidColorBrush x:Key="MicaGoChatBackgroundScrimBrush" Color="#61000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MicaGoMessageSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MicaGoMessageSelectedPointerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MicaGoComposerAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoSendAcrylicBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="MicaGoSendMaterialForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="MicaGoUnreadBadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MicaGoUnreadBadgeTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="MicaGoChatSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoContactBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoSecondaryPageBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoPageHeaderBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoPageHeaderForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MicaGoPageHeaderSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MicaGoIncomingMessageBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoComposerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoSubtleStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MicaGoChatChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoChatCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoChatBackgroundScrimBrush" Color="#00000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    </Style>
    <Style TargetType="RichTextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    </Style>
    <CornerRadius x:Key="MicaGoCardCornerRadius">4</CornerRadius>

    <Style x:Key="MicaGoIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Flutter-compatible circular composer commands retain native focus states. -->
    <Style x:Key="MicaGoComposerGlyphButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MicaGoIconButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Unigram-style splitter: a forgiving transparent hit target with only
         the native scrollbar thumb colour visible on hover/drag. -->
    <Style x:Key="MicaGoSidebarResizeGripStyle" TargetType="controls:SidebarResizeGrip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SidebarResizeGrip">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Indicator"
                                Width="2"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource ScrollBarThumbBackground}"
                                CornerRadius="1"
                                Opacity="0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows 11 Settings-style card: icon | title + description | control. -->
    <Style x:Key="MicaGoSettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MicaGoCardCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style x:Key="MicaGoSettingsHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,16,0,4" />
    </Style>

    <!-- Circular subtle icon button inside the composer pill (Flutter parity). -->
    <Style x:Key="MicaGoComposerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MicaGoIconButtonStyle}">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- The row presenter retains native selection/focus surfaces. The sidebar
         viewport owns the animated selection indicator, independently of recycling. -->
    <Style x:Key="MicaGoSettingsNavigationItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- Keep the WinUI presenter as the template root for native virtualization
         and focus; sidebar indicator animation is shared with settings. -->
    <Style x:Key="MicaGoChatListStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="MicaGoMessageListStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- Stable message wrappers retain their native containers. Keep content
             transitions empty during confirmation and selection changes. -->
        <Setter Property="ContentTransitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        ContentMargin="{TemplateBinding Padding}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="8"
                        CheckMode="Inline"
                        SelectionCheckMarkVisualEnabled="True"
                        CheckBrush="{ThemeResource ListViewItemCheckBrush}"
                        CheckPressedBrush="{ThemeResource ListViewItemCheckPressedBrush}"
                        CheckDisabledBrush="{ThemeResource ListViewItemCheckDisabledBrush}"
                        CheckBoxBrush="{ThemeResource ListViewItemCheckBoxBrush}"
                        CheckBoxPointerOverBrush="{ThemeResource ListViewItemCheckBoxPointerOverBrush}"
                        CheckBoxPressedBrush="{ThemeResource ListViewItemCheckBoxPressedBrush}"
                        CheckBoxDisabledBrush="{ThemeResource ListViewItemCheckBoxDisabledBrush}"
                        CheckBoxSelectedBrush="{ThemeResource ListViewItemCheckBoxSelectedBrush}"
                        CheckBoxSelectedPointerOverBrush="{ThemeResource ListViewItemCheckBoxSelectedPointerOverBrush}"
                        CheckBoxSelectedPressedBrush="{ThemeResource ListViewItemCheckBoxSelectedPressedBrush}"
                        CheckBoxSelectedDisabledBrush="{ThemeResource ListViewItemCheckBoxSelectedDisabledBrush}"
                        CheckBoxBorderBrush="{ThemeResource ListViewItemCheckBoxBorderBrush}"
                        CheckBoxPointerOverBorderBrush="{ThemeResource ListViewItemCheckBoxPointerOverBorderBrush}"
                        CheckBoxPressedBorderBrush="{ThemeResource ListViewItemCheckBoxPressedBorderBrush}"
                        CheckBoxDisabledBorderBrush="{ThemeResource ListViewItemCheckBoxDisabledBorderBrush}"
                        CheckBoxCornerRadius="{ThemeResource ListViewItemCheckBoxCornerRadius}"
                        SelectionIndicatorVisualEnabled="False"
                        PointerOverBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                        PressedBackground="{ThemeResource SubtleFillColorTertiaryBrush}"
                        SelectedBackground="{ThemeResource MicaGoMessageSelectedBrush}"
                        SelectedPointerOverBackground="{ThemeResource MicaGoMessageSelectedPointerBrush}"
                        SelectedPressedBackground="{ThemeResource MicaGoMessageSelectedPointerBrush}"
                        SelectedForeground="{ThemeResource TextFillColorPrimaryBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The native inline checkbox extends into the leading content padding. -->
    <Style x:Key="MicaGoSelectedMessageListStyle" TargetType="ListViewItem"
           BasedOn="{StaticResource MicaGoMessageListStyle}">
        <Setter Property="Padding" Value="16,0,12,0" />
    </Style>
</ResourceDictionary>
