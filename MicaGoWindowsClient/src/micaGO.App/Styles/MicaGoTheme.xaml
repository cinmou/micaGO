<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MicaGoChatSurfaceBrush" Color="#FFF7F7F7" />
            <SolidColorBrush x:Key="MicaGoContactBarBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="MicaGoIncomingMessageBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MicaGoComposerBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MicaGoSubtleStrokeBrush" Color="#12000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MicaGoChatSurfaceBrush" Color="#FF171717" />
            <SolidColorBrush x:Key="MicaGoContactBarBrush" Color="#F72C2C2C" />
            <SolidColorBrush x:Key="MicaGoIncomingMessageBrush" Color="#FF2C2C2E" />
            <SolidColorBrush x:Key="MicaGoComposerBrush" Color="#FF252525" />
            <SolidColorBrush x:Key="MicaGoSubtleStrokeBrush" Color="#16FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MicaGoChatSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoContactBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoIncomingMessageBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoComposerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MicaGoSubtleStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MicaGoChatSurfaceBrush" Color="#FFF7F7F7" />
            <SolidColorBrush x:Key="MicaGoContactBarBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="MicaGoIncomingMessageBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MicaGoComposerBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MicaGoSubtleStrokeBrush" Color="#12000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <CornerRadius x:Key="MicaGoCardCornerRadius">4</CornerRadius>

    <Style x:Key="MicaGoIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Windows 11 Settings-style card: icon | title + description | control. -->
    <Style x:Key="MicaGoSettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MicaGoCardCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style x:Key="MicaGoSettingsHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,16,0,4" />
    </Style>

    <Style x:Key="MicaGoChatListStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="MicaGoMessageListStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
</ResourceDictionary>
