<UserControl
    x:Class="MicaGo.App.Controls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,3">
        <Border x:Name="Bubble"
                MaxWidth="620"
                Padding="12,8,12,7"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="4">
                <TextBlock x:Name="SenderText"
                           Foreground="{StaticResource MicaGoAccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <Border x:Name="AttachmentPanel"
                        MinWidth="220"
                        MinHeight="90"
                        Padding="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                        <FontIcon Glyph="&#xE8B9;" FontSize="22" />
                        <TextBlock x:Name="AttachmentText" FontSize="12" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="BodyText"
                           TextWrapping="Wrap"
                           FontSize="14" />
                <TextBlock x:Name="FooterText"
                           HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
