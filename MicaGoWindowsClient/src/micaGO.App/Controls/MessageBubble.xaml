<UserControl
    x:Class="MicaGo.App.Controls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Row layout mirrors the Flutter client (message_thread_screen.dart):
      date separator pill / centered system caption / message row.
      Inside the message row the sender label sits ABOVE the bubble, the
      "Sent with …" label and delivery footer sit BELOW it, media renders as
      bubble-less blocks stacked above the (optional) text bubble, and
      reaction chips overlay the bubble's top corner.
    -->
    <StackPanel x:Name="Root" Margin="16,3,16,3">

        <Border x:Name="SeparatorChip"
                Margin="0,10,0,8"
                Padding="12,5"
                HorizontalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="12"
                Visibility="Collapsed">
            <TextBlock x:Name="SeparatorText"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>

        <TextBlock x:Name="SystemText"
                   Margin="32,4,32,4"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <Grid x:Name="MessageRow" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AvatarColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <PersonPicture x:Name="SenderAvatar"
                           Width="28"
                           Height="28"
                           VerticalAlignment="Bottom"
                           Visibility="Collapsed" />

            <StackPanel x:Name="ContentColumn"
                        Grid.Column="1"
                        MaxWidth="560"
                        HorizontalAlignment="Left">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="EntranceTransform" />
                </StackPanel.RenderTransform>

                <TextBlock x:Name="SenderText"
                           Margin="12,2,12,2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <ContentPresenter x:Name="LinkPreviewHost"
                                  Margin="0,0,0,4"
                                  Visibility="Collapsed" />

                <Border x:Name="ReplyPanel"
                        Margin="0,0,0,4"
                        Padding="10,6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        Tapped="ReplyPanel_Tapped">
                    <!-- RichTextBlock, not TextBlock: only RichTextBlock can host
                         InlineUIContainer (the Twemoji flag images). -->
                    <RichTextBlock x:Name="ReplyText"
                                   MaxWidth="420"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="False"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                </Border>

                <Grid x:Name="BubbleStack"
                      HorizontalAlignment="Left"
                      RenderTransformOrigin="0.5,1">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="BubbleTransform" />
                    </Grid.RenderTransform>
                    <StackPanel x:Name="BubbleBlocks" Spacing="4">
                        <StackPanel x:Name="MediaPanel" Spacing="4" />
                        <Border x:Name="Bubble"
                                Padding="12,7,12,8"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource MicaGoIncomingMessageBrush}"
                                CornerRadius="18,18,18,4">
                            <!-- RichTextBlock, not TextBlock: only RichTextBlock can
                                 host InlineUIContainer (the Twemoji flag images). -->
                            <RichTextBlock x:Name="BodyText"
                                           FontSize="14"
                                           IsTextSelectionEnabled="True"
                                           LineHeight="20"
                                           TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Border x:Name="ReactionChip"
                            Padding="8,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform Y="-10" />
                        </Border.RenderTransform>
                        <TextBlock x:Name="ReactionText" FontSize="13" />
                    </Border>

                    <Border x:Name="UploadDim"
                            Background="#2E000000"
                            CornerRadius="14"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    <ProgressRing x:Name="UploadRing"
                                  Width="34"
                                  Height="34"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsIndeterminate="False"
                                  Maximum="1"
                                  Visibility="Collapsed" />
                    <!-- Invisible Ink: the message stays covered until tapped;
                         tapping the "Sent with Invisible Ink" label re-hides it. -->
                    <Border x:Name="InkCover"
                            Background="#F28E8E93"
                            CornerRadius="14"
                            Visibility="Collapsed"
                            Tapped="InkCover_Tapped">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Text="✨" />
                    </Border>

                    <Border x:Name="FailedBadge"
                            Padding="10,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                            CornerRadius="12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Foreground="White" Glyph="&#xE7BA;" />
                            <TextBlock x:Name="FailedText"
                                       FontSize="11"
                                       Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel x:Name="EffectRow"
                            Margin="6,3,6,0"
                            Background="Transparent"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="Collapsed"
                            Tapped="EffectRow_Tapped">
                    <FontIcon FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE734;" />
                    <TextBlock x:Name="EffectText"
                               FontSize="10"
                               FontStyle="Italic"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock x:Name="FooterText"
                           Margin="6,2,6,0"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
