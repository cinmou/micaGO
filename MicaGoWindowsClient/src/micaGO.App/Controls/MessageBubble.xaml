<UserControl
    x:Class="MicaGo.App.Controls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Margin="18,2" ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="AvatarColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DirectionStates">
                <VisualState x:Name="Incoming">
                    <VisualState.Setters>
                        <Setter Target="Bubble.HorizontalAlignment" Value="Left" />
                        <Setter Target="Bubble.Background" Value="{ThemeResource MicaGoIncomingMessageBrush}" />
                        <Setter Target="Bubble.CornerRadius" Value="16,16,16,5" />
                        <Setter Target="SenderText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Outgoing">
                    <VisualState.Setters>
                        <Setter Target="Bubble.HorizontalAlignment" Value="Right" />
                        <Setter Target="Bubble.Background" Value="{ThemeResource MicaGoOutgoingMessageBrush}" />
                        <Setter Target="Bubble.CornerRadius" Value="16,16,5,16" />
                        <Setter Target="SenderText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="SeparatorChip" Grid.ColumnSpan="2" HorizontalAlignment="Center" Padding="10,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Visibility="Collapsed"><TextBlock x:Name="SeparatorText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border>

        <Border x:Name="SenderAvatar"
                Width="26"
                Height="26"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="13"
                Visibility="Collapsed">
            <Grid>
                <Image x:Name="SenderAvatarImage" Stretch="UniformToFill" />
                <TextBlock x:Name="SenderAvatarInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Border x:Name="Bubble"
                Grid.Column="1"
                MaxWidth="680"
                Padding="12,8,12,7"
                HorizontalAlignment="Left"
                Background="{ThemeResource MicaGoIncomingMessageBrush}"
                BorderBrush="{ThemeResource MicaGoSubtleStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource MicaGoMessageCornerRadius}">
            <Grid RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SenderText"
                           Foreground="{StaticResource MicaGoAccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <Border x:Name="AttachmentPanel"
                        Grid.Row="2"
                        MinWidth="220"
                        MinHeight="88"
                        Padding="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Tapped="AttachmentPanel_Tapped">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="7">
                        <Image x:Name="MediaImage" MaxWidth="420" MaxHeight="280" Stretch="Uniform" Visibility="Collapsed" />
                        <FontIcon x:Name="AttachmentIcon" Glyph="&#xE8B9;" FontSize="22" />
                        <TextBlock x:Name="AttachmentText" FontSize="12" />
                        <ProgressBar x:Name="UploadProgress" Width="160" Height="3" Minimum="0" Maximum="1" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Border x:Name="ReplyPanel" Grid.Row="1" Padding="8,5" Margin="0,0,0,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="7" Visibility="Collapsed"><TextBlock x:Name="ReplyText" MaxWidth="420" FontSize="11" TextTrimming="CharacterEllipsis"/></Border>
                <TextBlock x:Name="BodyText"
                           Grid.Row="3"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="20" />
                <TextBlock x:Name="FooterText"
                           Grid.Row="4"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="10" />
                <TextBlock x:Name="ReactionText" Grid.Row="5" Margin="0,2,0,-3" FontSize="14" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <TextBlock x:Name="EffectText"
                   Grid.Row="1"
                   Grid.Column="1"
                   Margin="8,2,8,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontSize="10"
                   FontStyle="Italic"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
