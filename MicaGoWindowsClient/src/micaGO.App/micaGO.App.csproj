<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MicaGo.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\micaGO.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\micaGO.Core\micaGO.Core.csproj" />
    <ProjectReference Include="..\micaGO.Infrastructure\micaGO.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\micaGO.Windows.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\micaGO.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TwemojiFlags\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TwemojiEmoji17\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\TWEMOJI-LICENSE-GRAPHICS.txt" Link="TWEMOJI-LICENSE-GRAPHICS.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
